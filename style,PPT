:root { --ink:#172033; --muted:#657087; --line:#e3e8f1; --paper:#f5f7fb; --blue:#3457d5; --blue2:#243eaa; }
* { box-sizing:border-box; }
body { margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; color:var(--ink); background:var(--paper); line-height:1.55; }
.wrap { width:min(960px, calc(100% - 32px)); margin:0 auto; }
.hero { background:linear-gradient(125deg,#15274f,#3457d5); color:white; padding:46px 0 42px; }
.eyebrow { letter-spacing:.16em; font-size:.75rem; font-weight:800; opacity:.78; }
h1 { margin:.15rem 0; font-size:clamp(2.4rem,7vw,4rem); letter-spacing:-.04em; }
.subtitle { margin:.2rem 0; font-size:1.25rem; font-weight:650; }
.intro { max-width:620px; opacity:.88; }
.main { padding:28px 0 44px; }
.panel,.result-card,.score-card { background:white; border:1px solid var(--line); border-radius:18px; padding:24px; box-shadow:0 8px 28px rgba(26,40,75,.045); }
h2 { margin:0 0 8px; font-size:1.45rem; }
h3 { margin:0 0 10px; font-size:1.05rem; }
.muted { color:var(--muted); }
label { display:block; font-weight:700; margin:18px 0 7px; }
input[type=file],textarea { width:100%; border:1px solid #ccd4e2; border-radius:10px; padding:12px; font:inherit; background:#fff; }
textarea { resize:vertical; }
input:focus,textarea:focus { outline:3px solid #dbe4ff; border-color:var(--blue); }
.or { text-align:center; color:var(--muted); margin:14px 0; font-size:.9rem; }
button { margin-top:20px; width:100%; border:0; border-radius:11px; padding:14px 18px; color:white; background:var(--blue); font-size:1rem; font-weight:800; cursor:pointer; }
button:hover { background:var(--blue2); }
.required { color:#c62828; }
.privacy,.disclaimer { color:var(--muted); font-size:.84rem; margin-bottom:0; }
.alert { padding:12px 15px; margin:0 0 16px; border-radius:10px; background:#fff1f0; color:#8d1e18; }
.results { margin-top:30px; }
.score-card { display:flex; align-items:center; gap:22px; margin:16px 0; }
.score-circle { flex:0 0 104px; width:104px; height:104px; border:8px solid #dce5ff; border-top-color:var(--blue); border-radius:50%; display:grid; place-items:center; }
.score-circle span { font-size:1.55rem; font-weight:850; }
.result-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.result-card.wide { grid-column:1 / -1; }
.chips { display:flex; flex-wrap:wrap; gap:8px; }
.chip { display:inline-block; border-radius:999px; padding:5px 10px; font-size:.86rem; background:#edf0f6; }
.chip.good { background:#e3f7eb; color:#17663a; }
.chip.missing { background:#fff0dc; color:#8a4c00; }
li { margin:8px 0; }
footer { color:var(--muted); text-align:center; padding:28px 0 0; font-size:.86rem; }
@media (max-width:650px) { .panel,.result-card,.score-card { padding:18px; } .score-card { align-items:flex-start; flex-direction:column; } .result-grid { grid-template-columns:1fr; } .result-card.wide { grid-column:auto; } }
